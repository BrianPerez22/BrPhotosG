# Copia este archivo a ".env" y ajusta los valores. ".env" está en .gitignore.
PORT=3002
HOST=0.0.0.0

# Carpeta raíz con las fotos (el usuario que ejecuta la app necesita leer y escribir)
PHOTOS_ROOT=/ruta/a/tus/fotos

# Dónde se guardan usuarios (users.json) y miniaturas. Por defecto: ./data
# DATA_DIR=/ruta/a/data

# Cadena aleatoria de 32+ caracteres:  openssl rand -hex 32
JWT_SECRET=cambia-esto-por-un-valor-aleatorio-largo

# Administrador inicial: solo se crea si todavía no existe ningún administrador
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-clave

# Tamaño máximo por archivo subido (MB)
MAX_UPLOAD_MB=500
