# Copia este archivo a ".env" y ajusta los valores. ".env" está en .gitignore.
PORT=3002
HOST=0.0.0.0

# ── Múltiples bibliotecas (recomendado) ───────────────────────────────────────
# Formato: Nombre=Ruta|Nombre2=Ruta2|Nombre3=Ruta3
# El nombre aparece en la interfaz y como prefijo en las rutas de la API.
# Si se define LIBRARIES, se ignora PHOTOS_ROOT.
#
# LIBRARIES=Fotos=/mnt/ssd/Fotos|Imágenes=/mnt/hdd/Imágenes|Videos=/mnt/hdd/Videos

# ── Biblioteca única (compatibilidad anterior) ─────────────────────────────────
# Si no defines LIBRARIES, se usa PHOTOS_ROOT como biblioteca única llamada "Fotos".
PHOTOS_ROOT=/ruta/a/tus/fotos

# Dónde se guardan usuarios (users.json) y miniaturas. Por defecto: ./data
# DATA_DIR=/ruta/a/data

# Cadena aleatoria de 32+ caracteres:  openssl rand -hex 32
JWT_SECRET=cambia-esto-por-un-valor-aleatorio-largo

# Administrador inicial: solo se crea si todavía no existe ningún administrador
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-clave

# Tamaño máximo por archivo subido (MB)
MAX_UPLOAD_MB=500
